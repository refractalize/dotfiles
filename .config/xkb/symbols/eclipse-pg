// Eclipse PG, mapped to standard US QWERTY physical positions.
// Source: eclipse-pg.jsonc
// Install without the .xkb extension at ~/.config/xkb/symbols/eclipse-pg

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    name[Group1] = "Eclipse PG";

    // Top row
    key <AD01> { [ b, B ] };
    key <AD02> { [ f, F ] };
    key <AD03> { [ r, R ] };
    key <AD04> { [ l, L ] };
    key <AD05> { [ v, V ] };
    key <AD06> { [ j, J ] };
    key <AD07> { [ p, P ] };
    key <AD08> { [ o, O ] };
    key <AD09> { [ u, U ] };
    key <AD10> { [ semicolon, colon ] };

    // Home row
    key <AC01> { [ n, N ] };
    key <AC02> { [ s, S ] };
    key <AC03> { [ h, H ] };
    key <AC04> { [ t, T ] };
    key <AC05> { [ d, D ] };
    key <AC06> { [ y, Y ] };
    key <AC07> { [ c, C ] };
    key <AC08> { [ a, A ] };
    key <AC09> { [ e, E ] };
    key <AC10> { [ i, I ] };
    key <AC11> { [ apostrophe, quotedbl ] };

    // Bottom row
    key <AB01> { [ z, Z ] };
    key <AB02> { [ x, X ] };
    key <AB03> { [ k, K ] };
    key <AB04> { [ m, M ] };
    key <AB05> { [ q, Q ] };
    key <AB06> { [ g, G ] };
    key <AB07> { [ w, W ] };
    key <AB08> { [ period, greater ] };
    key <AB09> { [ slash, question ] };
    key <AB10> { [ comma, less ] };
};
